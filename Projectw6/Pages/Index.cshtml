@* Ai promt: Design the view to display a table using the ClassInformationTable model that i gave you. Do not show the ID column. 
Include a filter section (inputs for name, description, min/max students, etc.), a Reset button styled like the Cancel button,
 and add pagination controls (Previous, Next, page numbers) 
below the table with matching style. Make sure to bind filter inputs to query parameters. *@

@page
@model IndexModel
@{
    ViewData["Title"] = "Arcade Class Manager";
}

<div class="row">
    <!-- Form Section (Left Side) -->
    <div class="col-md-4">
        <h2>@(Model.IsEditMode ? "Edit Class" : "Add Class")</h2>
        <form method="post">
            <input asp-for="NewClass.Id" type="hidden" />
            
            <div class="form-group mb-3">
                <label asp-for="NewClass.ClassName"></label>
                <input asp-for="NewClass.ClassName" class="form-control" placeholder=" " />
                <span asp-validation-for="NewClass.ClassName" class="text-danger"></span>
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="NewClass.StudentCount"></label>
                <input asp-for="NewClass.StudentCount" class="form-control" placeholder=" " />
                <span asp-validation-for="NewClass.StudentCount" class="text-danger"></span>
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="NewClass.Description"></label>
                <textarea asp-for="NewClass.Description" class="form-control" placeholder=" "></textarea>
            </div>
            
            <button type="submit" asp-page-handler="@(Model.IsEditMode ? "Edit" : "Add")" class="btn btn-primary w-100 mt-3">
                @(Model.IsEditMode ? "Update Class" : "Add Class")
            </button>
            
            @if (Model.IsEditMode)
            {
                <a href="/" class="btn btn-secondary w-100 mt-2">Cancel</a>
            }
        </form>
    </div>

    <!-- Table Section (Right Side) -->
    <div class="col-md-8">
        <h2>Class List</h2>
        
        <!-- Filter Section -->
        <div class="card mb-3">
            <div class="card-header">
                <h5 class="mb-0">Filter Classes</h5>
            </div>
            <div class="card-body">
                <form id="filterForm" method="get">
                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <label for="ClassNameFilter" class="form-label">Class Name</label>
                            <input type="text" class="form-control" id="ClassNameFilter" asp-for="ClassNameFilter" placeholder="Search by name...">
                        </div>
                        <div class="col-md-6 mb-2">
                            <label for="DescriptionFilter" class="form-label">Description</label>
                            <input type="text" class="form-control" id="DescriptionFilter" asp-for="DescriptionFilter" placeholder="Search by description...">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <label for="MinStudentCount" class="form-label">Min Students</label>
                            <input type="number" class="form-control" id="MinStudentCount" asp-for="MinStudentCount" min="1" max="100">
                        </div>
                        <div class="col-md-6 mb-2">
                            <label for="MaxStudentCount" class="form-label">Max Students</label>
                            <input type="number" class="form-control" id="MaxStudentCount" asp-for="MaxStudentCount" min="1" max="100">
                        </div>
                    </div>
                    
                    <input type="hidden" asp-for="CurrentPage" value="1" />
                    
                    <div class="text-end mt-2">
                        <a href="/" class="btn btn-outline-secondary me-2">Reset</a>
                        <button type="submit" class="btn btn-primary">Apply Filters</button>
                    </div>
                </form>
            </div>
        </div>
        
        <!-- Class Table -->
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Class Name</th>
                        <th>Student Count</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var classItem in Model.ClassTable)
                    {
                        <tr>
                            <td>@classItem.ClassName</td>
                            <td>@classItem.StudentCount</td>
                            <td>@classItem.Description</td>
                            <td>
                                <div class="d-flex">
                                    <a asp-page-handler="Edit" 
                                       asp-route-id="@classItem.Id" 
                                       asp-route-ClassNameFilter="@Model.ClassNameFilter"
                                       asp-route-MinStudentCount="@Model.MinStudentCount"
                                       asp-route-MaxStudentCount="@Model.MaxStudentCount"
                                       asp-route-DescriptionFilter="@Model.DescriptionFilter"
                                       asp-route-CurrentPage="@Model.CurrentPage"
                                       class="btn btn-sm btn-warning me-2">
                                        Edit
                                    </a>
                                    <form method="post">
                                        <input type="hidden" name="ClassNameFilter" value="@Model.ClassNameFilter" />
                                        <input type="hidden" name="MinStudentCount" value="@Model.MinStudentCount" />
                                        <input type="hidden" name="MaxStudentCount" value="@Model.MaxStudentCount" />
                                        <input type="hidden" name="DescriptionFilter" value="@Model.DescriptionFilter" />
                                        <input type="hidden" name="CurrentPage" value="@Model.CurrentPage" />
                                        <button type="submit" 
                                                asp-page-handler="Delete" 
                                                asp-route-id="@classItem.Id"
                                                class="btn btn-sm btn-danger">
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        <!-- Pagination -->
        @if (Model.TotalPages > 0)
        {
            <nav aria-label="Page navigation">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" 
                           asp-route-CurrentPage="@(Model.CurrentPage - 1)"
                           asp-route-ClassNameFilter="@Model.ClassNameFilter"
                           asp-route-MinStudentCount="@Model.MinStudentCount"
                           asp-route-MaxStudentCount="@Model.MaxStudentCount"
                           asp-route-DescriptionFilter="@Model.DescriptionFilter">
                            Previous
                        </a>
                    </li>
                    
                    @for (int i = Math.Max(1, Model.CurrentPage - 4); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 4); i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" 
                               asp-route-CurrentPage="@i"
                               asp-route-ClassNameFilter="@Model.ClassNameFilter"
                               asp-route-MinStudentCount="@Model.MinStudentCount"
                               asp-route-MaxStudentCount="@Model.MaxStudentCount"
                               asp-route-DescriptionFilter="@Model.DescriptionFilter">
                                @i
                            </a>
                        </li>
                    }
                    
                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" 
                           asp-route-CurrentPage="@(Model.CurrentPage + 1)"
                           asp-route-ClassNameFilter="@Model.ClassNameFilter"
                           asp-route-MinStudentCount="@Model.MinStudentCount"
                           asp-route-MaxStudentCount="@Model.MaxStudentCount"
                           asp-route-DescriptionFilter="@Model.DescriptionFilter">
                            Next
                        </a>
                    </li>
                </ul>
            </nav>
        }
        
        <!-- Pagination Summary -->
        <div class="text-center mt-2">
            <p>
                Showing page @Model.CurrentPage of @Model.TotalPages
                (@((Model.CurrentPage - 1) * Model.PageSize + 1) - @Math.Min(Model.CurrentPage * Model.PageSize, Models.ClassInformationModel.ClassList.Count) 
                of @Models.ClassInformationModel.ClassList.Count classes)
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-submit function for filter changes (optional)
        function setupAutoSubmit() {
            const filterInputs = document.querySelectorAll('#filterForm input');
            filterInputs.forEach(input => {
                input.addEventListener('change', function() {
                    // Reset to page 1 when filters change
                    document.getElementById('CurrentPage').value = 1;
                    // Submit the form
                    document.getElementById('filterForm').submit();
                });
            });
        }
        
        // Call setup function when document is ready
        document.addEventListener('DOMContentLoaded', setupAutoSubmit);
    </script>
}