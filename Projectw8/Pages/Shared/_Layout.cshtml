@* Update my layout page to create a login page and redirect to the table page when the login is successful. *@

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Projectw8</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <!-- Google Fonts for Retro/Neon Styles -->
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&family=Press+Start+2P&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Projectw8.styles.css" asp-append-version="true" />
</head>
<style>
    .column-header.selected {
        background-color: #007bff;
        color: white;
        cursor: pointer;
    }
    .column-data.selected-column {
        background-color: #e6f2ff;
    }
    .column-header {
        cursor: pointer;
    }
    .auth-container {
        position: absolute;
        top: 20px;
        right: 20px;
    }
    .user-dropdown-btn {
        background-color: #007bff;
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 4px;
    }
    .user-dropdown-btn:hover {
        background-color: #0069d9;
        color: white;
    }
</style>
<body>
    <div class="container">
        <!-- Authentication Status moved to body - Hide on login page -->
        <div class="auth-container">
    @if (Context.Session.GetString("username") != null)
    {
        <div class="dropdown">
            <button class="btn btn-secondary btn-sm dropdown-toggle" type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                Welcome, @Context.Session.GetString("username")
            </button>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                <li>
                    <a class="dropdown-item neon-logout" asp-page="/Table" asp-page-handler="Logout">Logout</a>
                </li>
            </ul>
        </div>
    }
    else
    {
        @if (!Context.Request.Path.Value.Contains("/Index"))
        {
            <a class="btn btn-outline-secondary btn-sm" asp-area="" asp-page="/Login">Login</a>
        }
    }
</div>

        <!-- Main Content -->
        <main role="main" class="pb-3 mt-5">
            
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>