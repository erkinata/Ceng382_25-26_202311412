@* Ai promt 2: Design the view to display a table using the ClassInformationTable model that i gave you. Do not show the ID column. 
Include a filter section (inputs for name, description, min/max students, etc.), a Reset button styled like the Cancel button,
 and add pagination controls (Previous, Next, page numbers) 
below the table with matching style. Make sure to bind filter inputs to query parameters. *@

@* Ai promt 3: Add an export button to the data table that works in two modes, only downloading the currently visible (filtered) data as json.
 Also, let users choose which columns they want to export. If no columns are selected, all columns are exported. 
 If some columns (for example 1 and 3) are selected, only those columns are exported. Make the selected columns visually apparent, 
for example by changing their color. All these operations should be user-friendly and visually understandable. *@


@* Ai promt 4: Add a visible logout button (for example, in the top navigation or header) that, when clicked, triggers a logout request to clear the session and cookies,
 and then redirects the user to the login page. Only show this logout button if the user is currently logged in (based on session or view data).
  Make sure that protected content, such as tables and filters, is only shown if the user is authenticated.
 Otherwise, redirect the user to the login page or show a relevant message. Display the logged-in user's name somewhere on the page, for example, "Welcome, Username" *@

@page
@model TableModel
@{
    ViewData["Title"] = "Arcade Class Manager";
}

<div class="row">
    <!-- Form Section (Left Side) -->
    <div class="col-md-4">
        <h2>@(Model.IsEditMode ? "Edit Class" : "Add Class")</h2>
        <form method="post">
            <input asp-for="NewClass.Id" type="hidden" />
            
            <div class="form-group mb-3">
                <label asp-for="NewClass.ClassName"></label>
                <input asp-for="NewClass.ClassName" class="form-control" placeholder=" " />
                <span asp-validation-for="NewClass.ClassName" class="text-danger"></span>
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="NewClass.StudentCount"></label>
                <input asp-for="NewClass.StudentCount" class="form-control" placeholder=" " />
                <span asp-validation-for="NewClass.StudentCount" class="text-danger"></span>
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="NewClass.Description"></label>
                <textarea asp-for="NewClass.Description" class="form-control" placeholder=" "></textarea>
            </div>
            
            <button type="submit" asp-page-handler="@(Model.IsEditMode ? "Edit" : "Add")" class="btn btn-primary w-100 mt-3">
                @(Model.IsEditMode ? "Update Class" : "Add Class")
            </button>
            
            @if (Model.IsEditMode)
            {
                <a href="/" class="btn btn-secondary w-100 mt-2">Cancel</a>
            }
        </form>
    </div>

    <!-- Table Section (Right Side) -->
    <div class="col-md-8">
        <h2>Class List</h2>
        
        <!-- Filter Section -->
        <div class="card mb-3">
            <div class="card-header">
                <h5 class="mb-0">Filter Classes</h5>
            </div>
            <div class="card-body">
                <form id="filterForm" method="get">
                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <label for="ClassNameFilter" class="form-label">Class Name</label>
                            <input type="text" class="form-control" id="ClassNameFilter" asp-for="ClassNameFilter" placeholder="Search by name...">
                        </div>
                        <div class="col-md-6 mb-2">
                            <label for="DescriptionFilter" class="form-label">Description</label>
                            <input type="text" class="form-control" id="DescriptionFilter" asp-for="DescriptionFilter" placeholder="Search by description...">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <label for="MinStudentCount" class="form-label">Min Students</label>
                            <input type="number" class="form-control" id="MinStudentCount" asp-for="MinStudentCount" min="1" max="100">
                        </div>
                        <div class="col-md-6 mb-2">
                            <label for="MaxStudentCount" class="form-label">Max Students</label>
                            <input type="number" class="form-control" id="MaxStudentCount" asp-for="MaxStudentCount" min="1" max="100">
                        </div>
                    </div>
                    
                    <input type="hidden" asp-for="CurrentPage" value="1" />
                    
                    <div class="text-end mt-2">
                        <a href="/" class="btn btn-outline-secondary me-2">Reset</a>
                        <button type="submit" class="btn btn-primary">Apply Filters</button>
                    </div>
                </form>
            </div>
        </div>
        <p><strong>Token ID:</strong> <span class="user-token">@Model.UserToken</span></p>
        <!-- JSON Export Section (Modified) -->
        <div class="card mb-3">
            <div class="card-header">
                <h5 class="mb-0">Export Options</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-12">
                        <p>Select columns to export by clicking on column headers in the table. Click "Export Data" to download the selected columns.</p>
                        <p class="small text-info">Current Selection: <span id="selectionSummary">All columns</span></p>
                        <form method="post" id="exportForm">
                            <!-- Pass filter parameters as hidden inputs -->
                            <input type="hidden" name="ClassNameFilter" value="@Model.ClassNameFilter" />
                            <input type="hidden" name="MinStudentCount" value="@Model.MinStudentCount" />
                            <input type="hidden" name="MaxStudentCount" value="@Model.MaxStudentCount" />
                            <input type="hidden" name="DescriptionFilter" value="@Model.DescriptionFilter" />
                            <input type="hidden" id="selectedColumnsInput" name="selectedColumns" value="">
                            <input type="hidden" id="exportFilteredInput" name="exportFiltered" value="false">
                            
                            <div class="d-flex justify-content-center">
                                <button type="button" id="exportButton" class="btn btn-success">
                                    Export Data
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Class Table -->
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th class="column-header" data-column="ClassName">Class Name</th>
                        <th class="column-header" data-column="StudentCount">Student Count</th>
                        <th class="column-header" data-column="Description">Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var classItem in Model.ClassTable)
                    {
                        <tr>
                            <td class="column-data" data-column="ClassName">@classItem.ClassName</td>
                            <td class="column-data" data-column="StudentCount">@classItem.StudentCount</td>
                            <td class="column-data" data-column="Description">@classItem.Description</td>
                            <td>
                                <div class="d-flex">
                                    <a asp-page-handler="Edit" 
                                       asp-route-id="@classItem.Id" 
                                       asp-route-ClassNameFilter="@Model.ClassNameFilter"
                                       asp-route-MinStudentCount="@Model.MinStudentCount"
                                       asp-route-MaxStudentCount="@Model.MaxStudentCount"
                                       asp-route-DescriptionFilter="@Model.DescriptionFilter"
                                       asp-route-CurrentPage="@Model.CurrentPage"
                                       class="btn btn-sm btn-warning me-2">
                                        Edit
                                    </a>
                                    <form method="post">
                                        <input type="hidden" name="ClassNameFilter" value="@Model.ClassNameFilter" />
                                        <input type="hidden" name="MinStudentCount" value="@Model.MinStudentCount" />
                                        <input type="hidden" name="MaxStudentCount" value="@Model.MaxStudentCount" />
                                        <input type="hidden" name="DescriptionFilter" value="@Model.DescriptionFilter" />
                                        <input type="hidden" name="CurrentPage" value="@Model.CurrentPage" />
                                        <button type="submit" 
                                                asp-page-handler="Delete" 
                                                asp-route-id="@classItem.Id"
                                                class="btn btn-sm btn-danger">
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        <!-- Pagination -->
        @if (Model.TotalPages > 0)
        {
            <nav aria-label="Page navigation">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" 
                           asp-route-CurrentPage="@(Model.CurrentPage - 1)"
                           asp-route-ClassNameFilter="@Model.ClassNameFilter"
                           asp-route-MinStudentCount="@Model.MinStudentCount"
                           asp-route-MaxStudentCount="@Model.MaxStudentCount"
                           asp-route-DescriptionFilter="@Model.DescriptionFilter">
                            Previous
                        </a>
                    </li>
                    
                    @for (int i = Math.Max(1, Model.CurrentPage - 4); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 4); i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" 
                               asp-route-CurrentPage="@i"
                               asp-route-ClassNameFilter="@Model.ClassNameFilter"
                               asp-route-MinStudentCount="@Model.MinStudentCount"
                               asp-route-MaxStudentCount="@Model.MaxStudentCount"
                               asp-route-DescriptionFilter="@Model.DescriptionFilter">
                                @i
                            </a>
                        </li>
                    }
                    
                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" 
                           asp-route-CurrentPage="@(Model.CurrentPage + 1)"
                           asp-route-ClassNameFilter="@Model.ClassNameFilter"
                           asp-route-MinStudentCount="@Model.MinStudentCount"
                           asp-route-MaxStudentCount="@Model.MaxStudentCount"
                           asp-route-DescriptionFilter="@Model.DescriptionFilter">
                            Next
                        </a>
                    </li>
                </ul>
            </nav>
        }
        
        <!-- Pagination Summary -->
        <div class="text-center mt-2">
            <p>
                Showing page @Model.CurrentPage of @Model.TotalPages
                (@((Model.CurrentPage - 1) * Model.PageSize + 1) - @Math.Min(Model.CurrentPage * Model.PageSize, Models.ClassInformationModel.ClassList.Count) 
                of @Models.ClassInformationModel.ClassList.Count classes)
            </p>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Auto-submit function for filter changes (optional)
    function setupAutoSubmit() {
        const filterInputs = document.querySelectorAll('#filterForm input');
        filterInputs.forEach(input => {
            input.addEventListener('change', function() {
                // Reset to page 1 when filters change
                document.getElementById('CurrentPage').value = 1;
                // Submit the form
                document.getElementById('filterForm').submit();
            });
        });
    }
    
    // Handle column selection for JSON export
    function setupColumnSelection() {
        // Column headers
        const columnHeaders = document.querySelectorAll('.column-header');
        const columnData = document.querySelectorAll('.column-data');
        const selectedColumnsInput = document.getElementById('selectedColumnsInput');
        const exportButton = document.getElementById('exportButton');
        const exportForm = document.getElementById('exportForm');
        const exportFilteredInput = document.getElementById('exportFilteredInput');
        const selectionSummary = document.getElementById('selectionSummary');
        
        // Track selected columns
        const selectedColumns = new Set();
        
        // Update visual highlighting of columns
        function updateSelectedColumnsVisual() {
            // Update the hidden input for form submission
            selectedColumnsInput.value = Array.from(selectedColumns).join(',');
            
            // Update visual highlighting of column headers
            columnHeaders.forEach(header => {
                const column = header.dataset.column;
                if (selectedColumns.size === 0 || selectedColumns.has(column)) {
                    header.classList.add('selected');
                } else {
                    header.classList.remove('selected');
                }
            });
            
            // Update visual highlighting of column data cells
            columnData.forEach(cell => {
                const column = cell.dataset.column;
                if (selectedColumns.size === 0 || selectedColumns.has(column)) {
                    cell.classList.add('selected-column');
                } else {
                    cell.classList.remove('selected-column');
                }
            });
            
            // Update selection summary text
            if (selectedColumns.size === 0) {
                selectionSummary.textContent = 'All columns';
            } else {
                selectionSummary.textContent = Array.from(selectedColumns).join(', ');
            }
        }
        
        // Add click event listeners to column headers
        columnHeaders.forEach(header => {
            if (header.dataset.column) { // Skip action column
                header.addEventListener('click', function(e) {
                    const column = this.dataset.column;
                    
                    // Toggle selection
                    if (selectedColumns.has(column)) {
                        selectedColumns.delete(column);
                    } else {
                        selectedColumns.add(column);
                    }
                    
                    updateSelectedColumnsVisual();
                });
            }
        });
        
        // Export button click handler - shows modal with options
       // Export button click handler - directly downloads filtered data
exportButton.addEventListener('click', function() {
    // Set the export type to filtered by default
    exportFilteredInput.value = "true";
    
    // Submit the form for export
    exportForm.action = '?handler=ExportFiltered';
    exportForm.submit();
});
        
        // Initialize visual state
        updateSelectedColumnsVisual();
    }
    
    // Call setup functions when document is ready
    document.addEventListener('DOMContentLoaded', function() {
        setupAutoSubmit();
        setupColumnSelection();
    });
</script>
}
